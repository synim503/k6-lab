# /etc/k6-lab.env  (chmod 600, chown root:root)
K6LAB_DB_URL=jdbc:postgresql://localhost:5432/k6lab
K6LAB_DB_USER=k6lab
K6LAB_DB_PASSWORD=change-me
# openssl rand -base64 32  -- СОХРАНИТЕ ОТДЕЛЬНО: без ключа секреты из БД не расшифровать
K6LAB_MASTER_KEY=
K6LAB_STORAGE_DIR=/var/lib/k6-lab/storage
K6LAB_HTTP_PORT=8080
K6LAB_AGENT_PORT=47331
# необязательно: пароль первого администратора (иначе будет сгенерирован и напечатан в журнал один раз)
# K6LAB_ADMIN_PASSWORD=
